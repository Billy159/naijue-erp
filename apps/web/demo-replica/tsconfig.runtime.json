{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "frontend/runtime/**/*.ts",
    "frontend/runtime/**/*.tsx",
    "frontend/runtime-bootstrap.ts",
    "frontend/runtime-styles.ts",
    "frontend/runtime-preview-transport.ts",
    "frontend/production-bootstrap.ts",
    "frontend/frozen-style-order.ts"
  ],
  "exclude": []
}
