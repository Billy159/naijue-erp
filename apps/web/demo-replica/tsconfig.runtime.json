{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "paths": {
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom/index.d.ts"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ]
    },
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "frontend/runtime/**/*.ts",
    "frontend/runtime/**/*.tsx",
    "frontend/runtime-bootstrap.ts",
    "frontend/runtime-styles.ts",
    "frontend/runtime-preview-transport.ts",
    "frontend/production-bootstrap.ts",
    "frontend/frozen-style-order.ts"
  ],
  "exclude": []
}
