      "IDEMPOTENCY_CONFLICT",
      "CATALOGUE_DELETED",
      "VERSION_STORAGE_OVERFLOW",
      "INVALID_CATALOGUE_STATE",
      "NO_CATALOGUE_CHANGE",
      "CATEGORY_CYCLE",
      "CATEGORY_DEPTH",
      "CATALOGUE_NAME_CONFLICT",
      "CATALOGUE_IN_USE"
    ]
  },
