  "semantics": {
    "scope_of_defaults": "Defaults apply only to creating a new product via the three factories in the frozen entry load order. They do not describe existing/imported product records or unrelated fixture helpers.",
    "base_vs_override": "Frozen index loads product-catalog.js, then barcode-2026.js, then product-master.js. Base C.newProduct explicitly sets price and purchasePrice to null and does not define the other seven configured price keys. The intermediate barcode wrapper spreads ...oldNew() through C.prepare and adds only barcode/fit defaults; it writes none of the nine price properties. The final product-master wrapper spreads its prior oldNew(), leaves purchasePrice inherited as null, explicitly writes price:null again, and writes minimumPrice and wholesale5..10 to null. Thus all nine effective defaults in this factory chain are null.",
    "display": "The table maps C.priceFields in array order and passes p[key]??\"\" to the input. null/undefined display blank; numeric 0 remains visible.",
    "hint_exact": "空白表示未设置；0 表示价格为零。",
    "manual_draft": "Generic input handling keeps the current input string; an empty draft may temporarily be \"\" before saving.",
    "paste": "Column paste uses C.priceFields order, begins at the focused field, trims each cell, writes null for an empty cell, and otherwise keeps the trimmed string until save.",
    "nonempty_validation": {
      "javascript_regex": "^\\d+(?:\\.\\d{1,2})?$",
      "additional_condition": "Number.isFinite(Number(p[key]))",
      "meaning": "Nonnegative decimal amount with at most two fractional digits. null/undefined/\"\" skip this nonempty-value check."
    },
    "save": "Base save normalizes price and purchasePrice: null/undefined/\"\" -> null; otherwise unary + converts to Number. Wrapped save converts all nonempty price fields with Number; empty non-price fields become null. Retail empty has already been normalized by base save. Numeric 0 is preserved.",
    "sort": "No separate sort value is defined in C.priceFields. order_1_based is the array index plus one.",
    "currency": "No currency code or cents-unit declaration is supplied by this static configuration; none has been invented."
  },
