 DO $$ BEGIN RAISE EXCEPTION 'DOCUMENT_APPEND_ADMISSION_REJECTED' USING ERRCODE='23514'; END $$;
\endif
\if :guards
\else
 DO $$ BEGIN RAISE EXCEPTION 'DOCUMENT_APPEND_ADMISSION_REJECTED' USING ERRCODE='23514'; END $$;
\endif
\if :sku_insert_columns
\else
 DO $$ BEGIN RAISE EXCEPTION 'DOCUMENT_APPEND_ADMISSION_REJECTED' USING ERRCODE='23514'; END $$;
\endif
\if :product_version_update
\else
 DO $$ BEGIN RAISE EXCEPTION 'DOCUMENT_APPEND_ADMISSION_REJECTED' USING ERRCODE='23514'; END $$;
\endif
\if :deferred_guard
\else
 DO $$ BEGIN RAISE EXCEPTION 'DOCUMENT_APPEND_ADMISSION_REJECTED' USING ERRCODE='23514'; END $$;
\endif
\if :actor_guard
\else
 DO $$ BEGIN RAISE EXCEPTION 'DOCUMENT_APPEND_ADMISSION_REJECTED' USING ERRCODE='23514'; END $$;
\endif
\if :sku_guard
\else
 DO $$ BEGIN RAISE EXCEPTION 'DOCUMENT_APPEND_ADMISSION_REJECTED' USING ERRCODE='23514'; END $$;
\endif
\if :barcode_guard
\else
 DO $$ BEGIN RAISE EXCEPTION 'DOCUMENT_APPEND_ADMISSION_REJECTED' USING ERRCODE='23514'; END $$;
\endif
\if :barcode_identity
\else
 DO $$ BEGIN RAISE EXCEPTION 'DOCUMENT_APPEND_ADMISSION_REJECTED' USING ERRCODE='23514'; END $$;
\endif
\if :require_barcode
 \if :insert_columns
 \else
 DO $$ BEGIN RAISE EXCEPTION 'DOCUMENT_APPEND_ADMISSION_REJECTED' USING ERRCODE='23514'; END $$;
 \endif
\endif
ROLLBACK;
\echo DOCUMENT_BARCODE_ADMISSION_ONLY_PASS
