\set ON_ERROR_STOP on
-- Disposable synthetic target, authenticated runtime role only.
\if :{?require_barcode}
\else
  \set require_barcode true
\endif
BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;
/* document-append:barcode-successor-v1 */ SELECT
 NOT EXISTS(SELECT 1 FROM (VALUES ('guard_maintenance_before_root()','76d30c01785877cfab4bb2bf167e1cdcd583677d204b7d7efa0c2cc2c79fa05c'),('validate_maintenance_root_commit()','bf853800c33c492dd0b8224e489c42dfb1c9a046231001a3d42be830a257f479'),('guard_maintenance_audit_actor()', '1635b883d65abb3938b277287ff7b0b1bf28cdae367b54b282b3e81810486e89'),('guard_native_creation_identity()', '765f060da0e51a0a18309502a412cc2196dcde633c3e9db0cbe4a2b6383d5111'),('validate_document_specification_commit()', '5c6dc02661516e469ebdada8469b4ac9626b77dbc26be026e11c06db759da047'),('guard_maintenance_child_write()', 'ceef464210d22280de7bc92ed900eebd3156ec65089ecdd8c55bbaca9c975d95'),('keep_barcode_binding_identity()', '14f6d02bca58955681e8d03236fb236cbfe3d041d35ecdb326cd3fa7e38d2733')) v(signature,sha) WHERE NOT EXISTS(
 SELECT 1 FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace JOIN pg_catalog.pg_language l ON l.oid=p.prolang WHERE p.oid=pg_catalog.to_regprocedure('naijue_erp.'||v.signature) AND p.prokind='f' AND p.provolatile='v' AND p.prosqlbody IS NULL AND p.proowner=n.nspowner AND l.lanname='plpgsql' AND NOT p.prosecdef AND NOT p.proretset AND p.pronargs=0 AND p.prorettype='trigger'::regtype AND p.proconfig=ARRAY['search_path=pg_catalog, naijue_erp, pg_temp']
 AND pg_catalog.encode(pg_catalog.sha256(pg_catalog.convert_to(p.prosrc,'UTF8')),'hex')=v.sha)) AS guards,
 EXISTS(SELECT 1 FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace JOIN pg_catalog.pg_language l ON l.oid=p.prolang WHERE p.oid=pg_catalog.to_regprocedure('naijue_erp.reject_document_runtime_reference_id_update_v1()') AND p.prokind='f' AND p.provolatile='v' AND p.prosqlbody IS NULL AND NOT p.prosecdef AND NOT p.proretset AND p.pronargs=0 AND p.prorettype='trigger'::regtype AND p.proowner=n.nspowner AND l.lanname='plpgsql' AND p.proconfig=ARRAY['search_path=pg_catalog'] AND pg_catalog.encode(pg_catalog.sha256(pg_catalog.convert_to(p.prosrc,'UTF8')),'hex')='c7eeff622fa4921991bae5b65c865402b3dbc3ee3fb310beafdf12b28dfddea6') AND NOT EXISTS(
 SELECT 1 FROM unnest(ARRAY['product_category','supplier','size_group','season','barcode_scheme','product_image']) tab(name)
 WHERE NOT pg_catalog.has_column_privilege(current_user,'naijue_erp.'||tab.name,'id','UPDATE') OR NOT EXISTS(
  SELECT 1 FROM pg_catalog.pg_trigger t WHERE t.tgrelid=pg_catalog.to_regclass('naijue_erp.'||tab.name) AND t.tgname='document_runtime_reference_id_lock_only' AND t.tgfoid=pg_catalog.to_regprocedure('naijue_erp.reject_document_runtime_reference_id_update_v1()') AND t.tgtype=19 AND t.tgenabled='O' AND NOT t.tgisinternal AND t.tgnargs=0 AND t.tgqual IS NULL AND t.tgattr=(SELECT a.attnum::text::int2vector FROM pg_catalog.pg_attribute a WHERE a.attrelid=t.tgrelid AND a.attname='id' AND NOT a.attisdropped))) AS reference_guards,
 (SELECT count(*)=6 AND bool_and(pg_catalog.has_column_privilege(current_user,'naijue_erp.sku_barcode',c,'INSERT'))
 FROM unnest(ARRAY['id','barcode','sku_id','barcode_kind','scheme_id','enabled']) c) AS insert_columns,
 (SELECT count(*)=9 AND bool_and(pg_catalog.has_column_privilege(current_user,'naijue_erp.sku',c,'INSERT'))
 FROM unnest(ARRAY['id','product_id','sku_code','color_id','fit_id','size_id','enabled','version','created_operation_id']) c) AS sku_insert_columns,
 pg_catalog.has_column_privilege(current_user,'naijue_erp.product','version','UPDATE') AS product_version_update,
 EXISTS(SELECT 1 FROM pg_catalog.pg_trigger t WHERE t.tgrelid='naijue_erp.product'::regclass AND t.tgname='product_maintenance_before_root' AND t.tgfoid='naijue_erp.guard_maintenance_before_root()'::regprocedure AND t.tgtype=23 AND t.tgenabled='O' AND NOT t.tgisinternal AND t.tgnargs=0 AND t.tgqual IS NULL AND t.tgattr=''::int2vector) AS root_before_guard,
 EXISTS(SELECT 1 FROM pg_catalog.pg_trigger t WHERE t.tgrelid='naijue_erp.product'::regclass AND t.tgname='product_maintenance_final_consistency' AND t.tgfoid='naijue_erp.validate_maintenance_root_commit()'::regprocedure AND t.tgtype=21 AND t.tgenabled='O' AND NOT t.tgisinternal AND t.tgnargs=0 AND t.tgdeferrable AND t.tginitdeferred AND t.tgqual IS NULL AND t.tgattr=''::int2vector) AS root_final_guard,
 EXISTS(SELECT 1 FROM pg_catalog.pg_trigger t WHERE t.tgrelid='naijue_erp.sku'::regclass AND t.tgname='sku_maintenance_write' AND t.tgfoid='naijue_erp.guard_maintenance_child_write()'::regprocedure AND t.tgtype=31 AND t.tgenabled='O' AND NOT t.tgisinternal AND t.tgnargs=0 AND t.tgqual IS NULL AND t.tgattr=''::int2vector) AS sku_write_guard,
 EXISTS(SELECT 1 FROM pg_catalog.pg_trigger t WHERE t.tgrelid='naijue_erp.audit_change'::regclass
 AND t.tgname='document_specification_commit' AND t.tgfoid='naijue_erp.validate_document_specification_commit()'::regprocedure
 AND t.tgtype=5 AND t.tgenabled='O' AND NOT t.tgisinternal AND t.tgnargs=0 AND t.tgdeferrable AND t.tginitdeferred AND t.tgqual IS NULL AND t.tgattr=''::int2vector) AS deferred_guard,
 EXISTS(SELECT 1 FROM pg_catalog.pg_trigger t WHERE t.tgrelid='naijue_erp.audit_change'::regclass AND t.tgname='maintenance_audit_actor' AND t.tgfoid='naijue_erp.guard_maintenance_audit_actor()'::regprocedure AND t.tgtype=7 AND t.tgenabled='O' AND NOT t.tgisinternal AND t.tgnargs=0 AND t.tgqual IS NULL) AS actor_guard,
 EXISTS(SELECT 1 FROM pg_catalog.pg_trigger t WHERE t.tgrelid='naijue_erp.sku'::regclass AND t.tgname='sku_creation_identity' AND t.tgfoid='naijue_erp.guard_native_creation_identity()'::regprocedure AND t.tgtype=23 AND t.tgenabled='O' AND NOT t.tgisinternal AND t.tgnargs=0 AND t.tgqual IS NULL AND t.tgattr=''::int2vector) AS sku_guard,
 EXISTS(SELECT 1 FROM pg_catalog.pg_trigger t WHERE t.tgrelid='naijue_erp.sku_barcode'::regclass AND t.tgname='barcode_maintenance_write' AND t.tgfoid='naijue_erp.guard_maintenance_child_write()'::regprocedure AND t.tgtype=31 AND t.tgenabled='O' AND NOT t.tgisinternal AND t.tgnargs=0 AND t.tgqual IS NULL AND t.tgattr=''::int2vector) AS barcode_guard,
 EXISTS(SELECT 1 FROM pg_catalog.pg_trigger t WHERE t.tgrelid='naijue_erp.sku_barcode'::regclass AND t.tgname='sku_barcode_retains_identity' AND t.tgfoid='naijue_erp.keep_barcode_binding_identity()'::regprocedure AND t.tgtype=27 AND t.tgenabled='O' AND NOT t.tgisinternal AND t.tgnargs=0 AND t.tgqual IS NULL AND t.tgattr=''::int2vector) AS barcode_identity

 \gset
\if :reference_guards
\else
 DO $$ BEGIN RAISE EXCEPTION 'DOCUMENT_APPEND_ADMISSION_REJECTED' USING ERRCODE='23514'; END $$;
\endif
\if :root_before_guard
\else
 DO $$ BEGIN RAISE EXCEPTION 'DOCUMENT_APPEND_ADMISSION_REJECTED' USING ERRCODE='23514'; END $$;
\endif
\if :root_final_guard
