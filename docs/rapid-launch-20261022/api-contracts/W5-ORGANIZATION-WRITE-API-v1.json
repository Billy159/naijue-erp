      "VERSION_STORAGE_OVERFLOW",
      "ORGANIZATION_REFERENCE_UNAVAILABLE",
      "WAREHOUSE_DEFAULT_IN_USE"
    ],
    "500": [
      "sanitized failure; recover with original request key"
    ]
  },
  "dependencies": [
    "0021 D1 receipt/audit",
    "0023 D1 warehouse.created_operation_id approved source/schema pending"
  ],
  "notClaimed": [
