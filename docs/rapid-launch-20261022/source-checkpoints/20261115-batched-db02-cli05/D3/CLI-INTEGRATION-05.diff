+    let batchOrdinal = 0;
+    let predecessor = null;
+    let previousLastOperationId = null;
+    let previousDescriptorSha256 = null;
+    let pending = null;
+    let document = null;
+    let phaseRank = 0;
+    let baselineClosed = false;
+    let documentsOpened = false;
+    let finalized = false;
+    let oversizedGroups = 0;
+    let maxGroupRows = 0;
+    let maxGroupBytes = 0;
+
+    function bind(request, batchId) {
