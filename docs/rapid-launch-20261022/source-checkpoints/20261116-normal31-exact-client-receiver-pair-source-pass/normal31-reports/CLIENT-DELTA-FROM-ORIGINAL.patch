+        if not re.fullmatch(r'[A-Za-z0-9_-][A-Za-z0-9_.-]{0,120}',path.name) or path.suffix not in {'.py','.mjs','.js','.json','.sh','.sql','.yaml','.yml','.md'}:continue
+        if re.search(r'(^|[_.-])(private|secret|credentials?|password|token|cookie)([_.-]|$)',path.name,re.I):
+            # This single reviewed code member is uploaded as its exact verified bytes.
+            if (args.task,job_id,cfg['grantId'],path.name)!=('T45','t45-r3-batched-install-20261115-01','b16447fbc81f4d64','private_transport.py'):continue
+            if path.is_symlink():continue
+            try:
+                with os.fdopen(os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK),'rb') as stream:
+                    meta=os.fstat(stream.fileno())
+                    if not stat.S_ISREG(meta.st_mode) or meta.st_nlink!=1 or meta.st_size!=12283:continue
