+ const service=proof.currentService,b=snapshot(service.physical,['systemIdentifier','databaseOid','serverVersionNum','postmasterStart']);
+ need(['systemIdentifier','databaseOid','serverVersionNum'].every(k=>b[k]===historical.physical[k])&&b.serverVersionNum==='170011','INSTALLED154_UPGRADE_SAME_PHYSICAL_REQUIRED');
+ need(typeof b.postmasterStart==='string'&&/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}(?:\.\d{1,6})?\+00$/.test(b.postmasterStart),'INSTALLED154_UPGRADE_REAL_EPOCH_REQUIRED');
