+  &&startsAt<expiresAt&&expiresAt-startsAt<=1200000&&expiresAt<=lease&&expiresAt<=backupAdminValidUntil,
+  'INSTALLED154_UPGRADE_FINITE_CURRENT_WINDOW_REQUIRED');
+ const descriptor=freeze({format:'FRESH35_INSTALLED154_UPGRADE_TARGET_BINDING_V1',purpose:'EXISTING154_TO161_CATALOG_UPGRADE_ONLY',
+  proposal:historical.proposal,physical:b,ordinary:historical.ordinary,startsAt,expiresAt,backupAdminValidUntil,
+  currentServiceSha256,serviceLeaseExpiresAt:lease,predecessorRecordSha256:proof.recordSha256,sourceSetSha256:proof.sourceSetSha256,
