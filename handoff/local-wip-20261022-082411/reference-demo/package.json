{
  "name": "naijue-8877-demo",
  "version": "1.0.0",
  "private": true,
  "description": "奈爵服饰 8877 Demo 当前唯一开发主线",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "zsh 启动Demo.command --no-open",
    "build": "node server/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint frontend/*.js frontend/*.mjs frontend/*.jsx server/*.mjs server/runtime/*.ts --no-warn-ignored",
    "test": "node server/run-tests.mjs",
    "clean:prepare": "python3 data-cleaning/cleaning/run_all.py",
    "data:receive": ".venv/bin/python data-cleaning/intake/receive.py",
    "check:dependencies": "node server/check-dependencies.mjs"
  },
  "dependencies": {
    "tsx": "4.20.5"
  },
  "devDependencies": {
    "@arco-design/web-react": "2.66.16",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "jsdom": "29.1.1",
    "jszip": "3.10.1",
    "pinyin-pro": "3.29.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "7.1.4"
  }
}
