{
  "name": "naijue-erp-v0.0.1",
  "version": "0.0.1",
  "private": true,
  "description": "奈爵服饰 ERP v0.0.1 工程（T07构建基础）",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-toolchain.mjs",
    "build": "node scripts/build.mjs",
    "build:backend": "node scripts/build-backend.mjs",
    "build:frontend": "node scripts/build-frontend.mjs",
    "typecheck": "node scripts/check-toolchain.mjs && tsc --noEmit -p tsconfig.json",
    "lint": "eslint frontend/*.js frontend/*.mjs frontend/*.jsx server/**/*.ts scripts/*.mjs --no-warn-ignored",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "test": "node --import tsx --test tests/*.test.mjs",
    "check": "npm run build && npm run lint && npm run check:dependencies && npm test",
    "release:pack": "node scripts/package-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "start": "node scripts/check-toolchain.mjs && node dist/server/main.js",
    "release:smoke": "node scripts/smoke-release.mjs",
    "database:plan": "node scripts/database.mjs plan",
    "database:bootstrap": "node scripts/database.mjs bootstrap",
    "database:migrate": "node scripts/database.mjs migrate",
    "database:inspect": "node scripts/database.mjs inspect",
    "test:database": "node scripts/t08-verify.mjs",
    "test:data-access": "node scripts/t09-verify.mjs",
    "test:auth": "node scripts/t10-verify.mjs",
    "verify:master-data": "node scripts/t12-verify.mjs",
    "media:migrate": "node --import tsx scripts/t13-media-migrate.mjs",
    "media:cleanup": "node --import tsx scripts/t13-media-cleanup.mjs",
    "media:verify": "node --import tsx scripts/t13-verify.mjs",
    "check:isolated": "node scripts/t14-check.mjs",
    "test:transactions": "node --import tsx --test tests/t17-transaction.test.mjs",
    "verify:transactions": "node --import tsx scripts/t17-verify.mjs",
    "verify:inventory": "node --import tsx scripts/t19-verify.mjs",
    "verify:products": "node --import tsx scripts/t18-verify.mjs",
    "verify:returns": "node --import tsx scripts/t22-verify.mjs",
    "verify:correction": "node scripts/t23-verify.mjs",
    "verify:reference-import": "node --import tsx scripts/t26-verify.mjs"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@arco-design/web-react": "2.66.16",
    "@types/node": "24.3.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "jsdom": "29.1.1",
    "jszip": "3.10.1",
    "pinyin-pro": "3.29.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "7.1.4"
  },
  "type": "module",
  "packageManager": "npm@11.19.0"
}
