{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "jsx": "react-jsx",
    "paths": {
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom/index.d.ts"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "adapters/**/*.ts",
    "tests/**/*.ts",
    "apps/**/*.tsx"
  ],
  "exclude": [
    "apps/web/unified-browser-harness/review-builds/**",
    "apps/web/demo-replica/frontend/runtime/**",
    "apps/web/demo-replica/frontend/runtime-bootstrap.ts",
    "apps/web/demo-replica/frontend/runtime-styles.ts",
    "apps/web/demo-replica/frontend/runtime-preview-transport.ts",
    "apps/web/demo-replica/frontend/production-bootstrap.ts",
    "apps/web/demo-replica/frontend/frozen-style-order.ts"
  ]
}
